# Ready solution and original task templates are published.
# Keep experiments, local guidance, datasets, outputs and the old uv.lock local.
/*
!/.gitignore
!/core.py
!/run.py
!/config.yaml
!/pyproject.toml
!/README.md
!/LICENSE
!/data.py
!/model.py
!/shadows/
/shadows/*
!/shadows/labels.csv

# Only the fixed-budget scanner and its base class/license are runtime dependencies.
!/optimizer.py
!/third_party/
/third_party/*
!/third_party/k_arm/
/third_party/k_arm/*
!/third_party/k_arm/Balanced_Scanner.py
!/third_party/k_arm/K_Arm_Scanner.py
!/third_party/k_arm/LICENSE

# Original task scripts; data/model stay at the project root.
!/old/
/old/*
!/old/evaluate.py
!/old/scores.py
!/old/detectors.py
!/old/run_detector.py
!/old/make_shadows.py
!/old/triggers.py
